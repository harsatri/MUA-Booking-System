# Port server (Render mengisi PORT otomatis; lokal default 3000)
PORT=3000

# Koneksi PostgreSQL (lokal / docker-compose / Neon)
# Neon: tambahkan ?sslmode=require di akhir URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/makeup_booking"

# Secret untuk menandatangani JWT — gunakan string acak yang panjang
JWT_SECRET="ganti-dengan-secret-acak-yang-panjang"

# Server key Midtrans SANDBOX (Dashboard Midtrans > Settings > Access Keys)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"

# URL frontend untuk CORS dan redirect pembayaran (tanpa trailing slash)
FRONTEND_URL="http://localhost:3001"
